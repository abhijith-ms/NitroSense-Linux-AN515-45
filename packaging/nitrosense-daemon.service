[Unit]
Description=NitroSense hardware controls
After=systemd-modules-load.service nitrosense-driver.service
Requires=nitrosense-driver.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/nitrosense/nitrosense-daemon.py
EnvironmentFile=/etc/nitrosense/access.conf
RuntimeDirectory=nitrosense
RuntimeDirectoryMode=0755
StateDirectory=nitrosense
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
